# Generate your own independent secrets. Never commit .env.
MCP_BEARER_TOKEN=
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=
MCP_ALLOW_URL_TOKEN=false

# Optional owner OAuth. Use a separate secret; configure HTTPS PUBLIC_URL.
# OAUTH_OWNER_SECRET=replace_with_another_random_secret
# OAUTH_STORE_PATH=/absolute/private/path/oauth-store.json

# Optional authorized Gold browser/session, provisioned under the service identity.
# FR24_BROWSER_PROFILE=C:/Private/live-transport/chrome-profile
# FR24_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# FR24_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9227
# FR24_WEB_SESSION_DPAPI_FILE=C:/Private/live-transport/web-session.dpapi
# FR24_HISTORY_KEYS_DPAPI_FILE=C:/Private/live-transport/history-keys.dpapi
# FR24_AIRPORT_SESSION_DPAPI_FILE=C:/Private/live-transport/airport-session.dpapi
# FR24_HISTORY_ENDPOINT_VERSION=legacy

# Optional persistent airport-event cache and resumable history jobs.
# FR24_HISTORY_CACHE_DIR=C:/Private/live-transport/history-cache
FR24_HISTORY_MIN_INTERVAL_MS=1000
# HISTORY_JOB_DIR=C:/Private/live-transport/history-jobs

# Optional Sentinel Hub credentials, provisioned separately.
# COPERNICUS_ENV_FILE=/absolute/private/path/copernicus.env
